# ── Production environment template ─────────────────────────────────
# Every adapter binds ONLY when its variables are set; unset = safe
# default (no-op providers, loud-failing IdP/KMS). Fill everything in
# this file before launch — docs/launch-checklist.md tracks the owners.

# Core (managed services)
DATABASE_URL=postgres://crm:CHANGE_ME@db.internal:5432/crm
REDIS_URL=redis://redis.internal:6379
PORT=3000
PUBLIC_BASE_URL=https://api.yourdomain.example

# Keycloak (identity)
KEYCLOAK_ISSUER=https://auth.yourdomain.example/realms/crm
KEYCLOAK_ADMIN_CLIENT_ID=crm-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME

# Crypto-shredding master key (KMS-held; base64, exactly 32 bytes)
KMS_MASTER_KEY=CHANGE_ME
# Suppression list HMAC key (KMS-held)
SUPPRESSION_HMAC_KEY=CHANGE_ME

# Object storage (S3 or compatible)
S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
S3_REGION=eu-west-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=crm-production

# Messaging
SMTP_URL=smtps://user:pass@smtp.eu-provider.example:465
EMAIL_FROM=no-reply@yourdomain.example
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_FROM=+32CHANGE_ME
FCM_SERVICE_ACCOUNT={"project_id":"...","client_email":"...","private_key":"..."}
PROVIDER_WEBHOOK_SECRET=CHANGE_ME

# Geocoding (EU-hosted / self-hosted Nominatim — processor register!)
GEOCODER_URL=https://nominatim.internal.example

# App version gates (optional at launch)
APP_MIN_VERSION_IOS=
APP_MIN_VERSION_ANDROID=
APP_WARN_VERSION_IOS=
APP_WARN_VERSION_ANDROID=

# Dispatch tuning (defaults apply when unset — see runbook §1)
DISPATCH_STRATEGY=hybrid
OFFER_TTL_SECONDS=120
