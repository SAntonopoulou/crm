# Local development (docker-compose maps Postgres to 54321 to avoid a host Postgres on 5432)
DATABASE_URL=postgres://crm:crm@localhost:54321/crm
REDIS_URL=redis://localhost:6379
PORT=3000

# Keycloak (docker compose --profile auth up -d; admin/admin)
KEYCLOAK_ISSUER=http://localhost:8082/realms/crm

# HMAC key for the suppression list (KMS-held in production)
SUPPRESSION_HMAC_KEY=change-me
