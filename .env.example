# Local development (docker-compose maps Postgres to 54321 to avoid a host Postgres on 5432)
DATABASE_URL=postgres://crm:crm@localhost:54321/crm
REDIS_URL=redis://localhost:6379
PORT=3000

# Keycloak (docker compose --profile auth up -d; admin/admin)
KEYCLOAK_ISSUER=http://localhost:8082/realms/crm

# HMAC key for the suppression list (KMS-held in production)
SUPPRESSION_HMAC_KEY=change-me

# Field-encryption master key (KMS-held in production; base64 32 bytes)
KMS_MASTER_KEY=
# S3-compatible storage (MinIO dev / S3 prod); LocalDisk fallback when unset
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
# Shared secret for provider delivery/bounce webhooks
PROVIDER_WEBHOOK_SECRET=
# Real adapters bind only when configured:
KEYCLOAK_ADMIN_CLIENT_ID=crm-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=
SMTP_URL=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
FCM_SERVICE_ACCOUNT=
GEOCODER_URL=
